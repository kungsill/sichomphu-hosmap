# ===== Smart Hospital Navigation — ตัวอย่างการตั้งค่า (คัดลอกเป็นไฟล์ .env) =====
HOSPITAL_NAME=โรงพยาบาลสีชมพู

# ฐานข้อมูลระบบนำทาง (แยกจาก HOSxP) — ค่าเริ่มต้นใช้ SQLite ใน data/
# NAV_DB_URL=mysql+pymysql://nav_user:รหัสผ่าน@127.0.0.1:3306/hospital_navigation?charset=utf8mb4

# mock = โหมดสาธิต (จำลองผู้ป่วย) | mysql = เชื่อม HOSxP V4 จริงแบบอ่านอย่างเดียว
HOSXP_MODE=mock
# บัญชีต้องมีสิทธิ์ SELECT เท่านั้น
# HOSXP_DB_URL=mysql+pymysql://nav_readonly:รหัสผ่าน@HOSXP_SERVER:3306/hos?charset=utf8mb4
# HOSXP_QUERY_FILE=hosxp_queries.ini
POLL_SECONDS=3

# URL ที่มือถือผู้ป่วยเปิดได้ (ใช้สร้าง QR) เช่น http://nav.sichomphu.local:8090
# PUBLIC_BASE_URL=http://192.168.1.50:8090

# รหัสผ่านหน้าจอเจ้าหน้าที่และ Map Builder (ต้องตั้งก่อนใช้งานจริง)
STAFF_USER=admin
STAFF_PASSWORD=

SHOW_VITALS=true
TOKEN_VALID_HOURS=18

# โหมดสาธิต
DEMO_SPEED=12
DEMO_START_TIME=07:30
DEMO_WARMUP_MINUTES=150
